# normalise line endings to LF for text files
* text=auto eol=lf

# binaries — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.db binary
*.sqlite binary

# shell scripts must be LF
*.sh text eol=lf
*.command text eol=lf
