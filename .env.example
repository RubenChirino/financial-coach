# ────────────────────────────────────────────────────────────────
# Personal AI Financial Coach — environment template
# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local`.
# ────────────────────────────────────────────────────────────────

# === Core ===
# Internal encryption key seed. Generate with: openssl rand -hex 32
# This seed is combined with your PIN (via scrypt) to derive the at-rest key.
APP_SECRET=

# === GoCardless Bank Account Data (formerly Nordigen) ===
# Sign up free at https://bankaccountdata.gocardless.com
# Then create a user agreement and get these from the API section.
# See docs/bank-setup.md for the full walkthrough.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# === LLM Provider ===
# One of: ollama | anthropic | openai | google
LLM_PROVIDER=ollama

# --- If using Ollama (local, default, recommended for privacy) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# --- If using Anthropic Claude ---
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- If using OpenAI ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- If using Google Gemini ---
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# === Optional ===
# Bind host. Keep 127.0.0.1 for local-only. Change to 0.0.0.0 to expose on LAN
# (not recommended — a conspicuous warning is printed at startup if you do).
HOST=127.0.0.1
PORT=3000

# UI default locale: es | en
DEFAULT_LOCALE=es
