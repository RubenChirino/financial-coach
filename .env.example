# ────────────────────────────────────────────────────────────────
# Personal AI Financial Coach — environment template
# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local`.
# ────────────────────────────────────────────────────────────────

# === Core ===
# Internal encryption key seed. Generate with: openssl rand -hex 32
# This seed is combined with your PIN (via scrypt) to derive the at-rest key.
APP_SECRET=

# === Database ===
# Defaults to a SQLite file at ./data/financial-coach.db. Override to point
# at a hosted libSQL (Turso) database for production.
#   Local file:  DATABASE_URL=./data/financial-coach.db  (or omit entirely)
#   In-memory:   DATABASE_URL=:memory:                   (testing only)
#   Turso:       DATABASE_URL=libsql://your-db.turso.io
#                TURSO_AUTH_TOKEN=eyJ...                 (from Turso dashboard)
# DATABASE_URL=
# TURSO_AUTH_TOKEN=

# === Authentication mode ===
# "local" (default): single-user 4-digit PIN flow. No external accounts.
# "oauth": multi-user Auth.js with Google + Microsoft sign-in.
#   Use this for hosted deployments (e.g. Vercel) where multiple friends /
#   family members will sign in.
AUTH_MODE=local

# --- OAuth mode (only required when AUTH_MODE=oauth) ---
# Auth.js JWT signing secret. Generate with: openssl rand -hex 32
# AUTH_SECRET=

# Google OAuth client — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {your-domain}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft Entra (Azure AD) OAuth client — create at
# https://entra.microsoft.com/  → "App registrations" → "New registration"
# Redirect URI (Web): {your-domain}/api/auth/callback/microsoft-entra-id
# Use "common" tenant to accept any personal/work Microsoft account.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# === GoCardless Bank Account Data (formerly Nordigen) ===
# Sign up free at https://bankaccountdata.gocardless.com
# Then create a user agreement and get these from the API section.
# See docs/bank-setup.md for the full walkthrough.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# === LLM Provider ===
# One of: ollama | anthropic | openai | google
#
# Hosted-mode note (AUTH_MODE=oauth): Ollama runs locally; serverless hosts
# (Vercel) can't reach it. The resolver automatically falls back to Gemini
# in hosted mode regardless of this value. For a hosted deploy, set this to
# "google" and provision GOOGLE_GENERATIVE_AI_API_KEY below.
LLM_PROVIDER=ollama

# --- If using Ollama (local, default, recommended for privacy) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# --- If using Anthropic Claude ---
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- If using OpenAI ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- If using Google Gemini ---
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# === Optional ===
# Bind host. Keep 127.0.0.1 for local-only. Change to 0.0.0.0 to expose on LAN
# (not recommended — a conspicuous warning is printed at startup if you do).
HOST=127.0.0.1
PORT=3000

# UI default locale: es | en
DEFAULT_LOCALE=es
