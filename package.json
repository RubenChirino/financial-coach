{
  "name": "financial-coach",
  "version": "0.1.0",
  "description": "Local-first, open-source personal AI financial coach. PSD2 bank aggregation, LLM-powered categorization, private-by-default.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Ruben Chirino <rubenchch21@gmail.com>",
  "homepage": "https://github.com/rubenchirino/financial-coach",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubenchirino/financial-coach.git"
  },
  "bugs": {
    "url": "https://github.com/rubenchirino/financial-coach/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev -H ${HOST:-127.0.0.1} -p ${PORT:-3000}",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-3000}",
    "start:prod": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-dev.ts",
    "gitleaks": "gitleaks detect --source . --verbose --redact",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.93",
    "@ai-sdk/google": "^2.0.86",
    "@ai-sdk/openai": "^2.0.117",
    "@ai-sdk/react": "^2.0.230",
    "@hookform/resolvers": "^3.10.0",
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.101.0",
    "ai": "^5.0.228",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "ollama-ai-provider-v2": "^1.5.5",
    "react": "^19.0.8",
    "react-dom": "^19.0.8",
    "react-hook-form": "^7.79.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.9",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.30.6",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@biomejs/biome", "@tailwindcss/oxide"],
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "esbuild@<0.25.0": ">=0.25.0",
      "jsondiffpatch@<0.7.2": ">=0.7.2",
      "sharp@<0.35.0": ">=0.35.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "shell-quote@<1.9.0": ">=1.9.0",
      "dompurify@<3.4.12": ">=3.4.12",
      "uuid@<11.1.1": "^11.1.1",
      "undici@<6.28.0": "^6.28.0"
    }
  }
}
