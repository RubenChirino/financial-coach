{
  "name": "financial-coach",
  "version": "0.1.0",
  "description": "Local-first, open-source personal AI financial coach. PSD2 bank aggregation, LLM-powered categorization, private-by-default.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Ruben Chirino <rubenchch21@gmail.com>",
  "homepage": "https://github.com/rubenchirino/financial-coach",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubenchirino/financial-coach.git"
  },
  "bugs": {
    "url": "https://github.com/rubenchirino/financial-coach/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev -H ${HOST:-127.0.0.1} -p ${PORT:-3000}",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-3000}",
    "start:prod": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-dev.ts",
    "gitleaks": "gitleaks detect --source . --verbose --redact",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.130",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.1",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.9.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "ollama-ai-provider-v2": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "esbuild@<0.25.0": ">=0.25.0",
      "jsondiffpatch@<0.7.2": ">=0.7.2",
      "sharp@<0.35.5": ">=0.35.5",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "shell-quote@<1.11.0": ">=1.11.0",
      "dompurify@<3.4.16": ">=3.4.16",
      "uuid@<11.1.1": "^11.1.1",
      "undici@<6.28.0": "^6.28.0",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "baseline-browser-mapping@<2.11.0": "^2.11.0"
    }
  }
}
