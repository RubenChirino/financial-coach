{
  "name": "financial-coach",
  "version": "0.1.0",
  "description": "Local-first, open-source personal AI financial coach. PSD2 bank aggregation, LLM-powered categorization, private-by-default.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Ruben Chirino (https://github.com/RubenChirino)",
  "homepage": "https://github.com/rubenchirino/financial-coach",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubenchirino/financial-coach.git"
  },
  "bugs": {
    "url": "https://github.com/rubenchirino/financial-coach/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev -H ${HOST:-127.0.0.1} -p ${PORT:-3000}",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-3000}",
    "start:prod": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-dev.ts",
    "gitleaks": "gitleaks detect --source . --verbose --redact",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/react": "^4.0.167",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.10.1",
    "drizzle-orm": "^0.45.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "ollama-ai-provider-v2": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "esbuild@<0.25.0": ">=0.25.0",
      "jsondiffpatch@<0.7.2": ">=0.7.2",
      "sharp@<0.35.5": ">=0.35.5",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "shell-quote@<1.11.0": ">=1.11.0",
      "dompurify@<3.4.17": ">=3.4.17",
      "uuid@<11.1.1": "^11.1.1",
      "undici@<6.28.0": "^6.28.0",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "baseline-browser-mapping@<2.11.0": "^2.11.0"
    }
  }
}
